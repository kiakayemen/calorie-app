generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Meal {
    id                    String   @id @default(cuid())

    userId                String?

    title                 String
    description           String

    calories              Float
    protein               Float
    carbs                 Float
    fat                   Float

    confidence            Float

    needsClarification    Boolean  @default(false)
    clarificationQuestion String?

    eatenAt               DateTime @default(now())
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    @@index([userId])
    @@index([userId, eatenAt])
}

model Settings {
    id                 String   @id @default(cuid())

    userId             String?  @unique

    calorieGoal        Int      @default(2200)
    notificationHour   Int      @default(21)
    notificationMinute Int      @default(0)
    timezone           String   @default("Asia/Tehran")

    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
}

model PushSubscription {
    id        String   @id @default(cuid())

    userId    String?

    endpoint  String   @unique
    p256dh    String
    auth      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

model DailySummaryDelivery {
    id        String   @id @default(cuid())

    userId    String?
    dateKey   String

    sentAt    DateTime @default(now())

    @@unique([userId, dateKey])
    @@index([userId])
}