generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Meal {
    id                    String   @id @default(cuid())
    title                 String
    description           String

    calories              Float
    protein               Float
    carbs                 Float
    fat                   Float

    confidence            Float

    needsClarification    Boolean  @default(false)
    clarificationQuestion String?

    eatenAt                DateTime @default(now())
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt

    @@index([eatenAt])
}

model Settings {
    id                 String   @id @default("default")
    calorieGoal        Int      @default(2200)
    notificationHour   Int      @default(21)
    notificationMinute Int      @default(0)
    timezone           String   @default("Asia/Tehran")

    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
}

model PushSubscription {
    id        String   @id @default(cuid())

    endpoint  String   @unique
    p256dh    String
    auth      String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}